      "checkConstraints": {
        "booking_assessments_status_check": {
          "name": "booking_assessments_status_check",
          "value": "status IN ('received','reviewing','quoted','scheduled','closed','declined')"
        },
        "booking_assessments_crm_status_check": {
          "name": "booking_assessments_crm_status_check",
          "value": "crm_status IN ('pending','delivered','failed','not_configured')"
        },
        "booking_assessments_condition_check": {
          "name": "booking_assessments_condition_check",
          "value": "condition_level IN ('maintenance-light','moderate','heavy-deep','specialist-review')"
        },
        "booking_assessments_preferred_contact_check": {
          "name": "booking_assessments_preferred_contact_check",
          "value": "preferred_contact IN ('text','call','email')"
        },
        "booking_assessments_service_check": {
          "name": "booking_assessments_service_check",
          "value": "service IN ('detailing','mobile-detailing','tint','ceramic','ppf','wrap','maintenance','tires','auto-glass','key-replacement','residential-tint')"
        },
        "booking_assessments_photo_count_check": {
          "name": "booking_assessments_photo_count_check",
          "value": "photo_count BETWEEN 1 AND 6"
        },
        "booking_assessments_json_check": {
          "name": "booking_assessments_json_check",
          "value": "json_valid(configuration_json) AND json_valid(asset_json) AND json_valid(concerns_json) AND json_valid(attribution_json) AND (location_json IS NULL OR json_valid(location_json))"
        }
      }
