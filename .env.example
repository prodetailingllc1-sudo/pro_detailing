# Canonical public origin used for metadata, sitemap, robots and structured data.
# Change this to the final custom domain before launch.
NEXT_PUBLIC_SITE_ORIGIN=https://pro-detailing.prodetailingllc1.chatgpt.site

# Publish a HighLevel form and paste its HTTPS share/embed URL here.
# When present, /request-quote renders it inside the branded quote experience.
GHL_FORM_URL=

# Alternative: use a HighLevel inbound-webhook URL for the native branded form.
# The server route validates and forwards the lead; this secret is never sent to browsers.
GHL_WEBHOOK_URL=

# Keep customer-data and photo submission disabled during design review.
# Enable only after the private D1/R2 storage and exact HighLevel webhook
# destination are approved and the booking-assessment API is activated.
NEXT_PUBLIC_BOOKING_SUBMISSIONS_ENABLED=false

# Required server-side gate for the future booking upload API. The public flag above
# is presentation-only and must never be the authorization boundary.
BOOKING_SUBMISSIONS_ENABLED=false

# Owner switch for the mobile-detailing service across navigation, forms and sitemap.
# Set to false, off, no or 0 to hide it without changing source code.
NEXT_PUBLIC_MOBILE_DETAILING_ENABLED=true
